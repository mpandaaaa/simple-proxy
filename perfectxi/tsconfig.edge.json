{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "supabase/functions/_engine",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false
  },
  "include": ["src/engine/**/*.ts", "src/data/**/*.ts"]
}
